{
  "name": "lal-clone",
  "version": "0.0.0",
  "private": true,
  "description": "Pixel-faithful frontend clone of likealocalguide.com, captured not eyeballed. Reference material: not product surface.",
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "next build",
    "start": "next start --port 4310",
    "typecheck": "tsc --noEmit",
    "capture": "node tools/capture.mjs",
    "verify": "node tools/verify.mjs",
    "dev:lan": "next dev -H 0.0.0.0 --port 4310",
    "start:lan": "next start -H 0.0.0.0 --port 4310",
    "assets:native": "uv run --with pillow python tools/generate-native-assets.py",
    "cap:sync": "node tools/cap-sync.mjs",
    "cap:run:android": "node tools/cap-sync.mjs android && cap run android",
    "cap:open:android": "cap open android",
    "cap:add:android": "cap add android",
    "cap:doctor": "cap doctor",
    "preview:gallery": "node tools/preview-gallery.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.25",
    "next": "15.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.49.1",
    "typescript": "~5.9.3"
  }
}
