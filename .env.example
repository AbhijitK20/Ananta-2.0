# Accounts and cloud saves. Copy to `.env.local` and fill in. `.env.local` is
# gitignored; this template is the only version that is committed.
#
# Until these are set the app still runs exactly as it did: the quest book and
# the trip planner keep working on localStorage, and sync stays off.
#
# Three values. The Supabase anon key, publishable key and service-role key are
# all deliberately absent — this app talks to Postgres directly instead of
# through PostgREST, so none of them are read. See "Accounts and cloud saves" in
# the README for why asking for them would only widen the attack surface.

# Where the app is reachable. Must match what you type in the browser: the
# session cookie's origin comes from here.
NEXT_PUBLIC_APP_URL=http://localhost:4310

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# There is no committed fallback. A hardcoded default would be a signing key
# anyone with the repo could forge sessions with; instead the app generates a
# random per-process value and warns, which cannot be forged but does not
# survive a restart.
BETTER_AUTH_SECRET=

# Supabase → Project Settings → Database → Connection string → URI, on port
# 5432 (the pooler), NOT the session-mode 6543. Better Auth opens real
# transactions, which the transaction pooler will not accept.
#
# This is the one people miss: it is the DATABASE PASSWORD, which is not the
# service-role key, not the publishable key, and not the anon key. Reset it under
# Project Settings → Database if you have to.
#
#   postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=
