# =============================================================================
# TravelBuddy — environment
#
# Copy to `.env.local`. Every variable is OPTIONAL: with none of them set the
# whole app works, and so does the AI assistant, on its offline answer path.
# Nothing here is required to run `npm run dev`.
#
# The AI assistant degrades rather than fails. See docs/AI_ASSISTANT_ARCHITECTURE.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Nugen Intelligence — the AI assistant's model provider
# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY. This key is read in exactly one module,
# `src/features/assistant/provider/config.ts`, and a test asserts that no
# "use client" module can reach it (tests/assistant/security.test.ts). It must
# never be prefixed with NEXT_PUBLIC_.
#
# Get one at https://nugen.in
NUGEN_API_KEY=

# The customized model's id, produced by `npm run assistant:align` and written to
# data/reference/nugen/assistant-alignment.json.
#
# You normally do NOT set this. The app reads the alignment record written by the
# align script, so a re-alignment needs no config change. Set it only to pin a
# specific model in a specific environment.
#
# This must be a CUSTOMIZED model id. There is deliberately no base-model
# fallback: if it is unset and there is no alignment record, the assistant says
# so on /api/assistant/health and answers offline, rather than silently running a
# base model and making the alignment claim unfalsifiable.
NUGEN_CUSTOMIZED_MODEL_ID=

# The base model an alignment ran against, for provenance display only. It is
# NEVER sent as the `model` field at runtime. Set it to make the baseline arm of
# `npm run assistant:eval` work.
NUGEN_BASE_MODEL=llama-v3p2-3b-reasoning

# API base. Override for a self-hosted or regional Nugen deployment.
NUGEN_BASE_URL=https://api.nugen.in/api/v3

# Total budget for one provider call, in ms. Clamped to 500–120000.
NUGEN_TIMEOUT_MS=20000

# Kill switch. Set to 1 to force the offline path with a key still configured —
# this is how you prove the assistant works without their platform.
# NUGEN_OFF=1

# -----------------------------------------------------------------------------
# Assistant limits
# -----------------------------------------------------------------------------
# Messages per minute per owner. Also capped by a burst window (5 per 10s by
# default) so a client retrying on a 502 cannot spend a paid call per attempt.
# ASSISTANT_RPM=20
# ASSISTANT_BURST=5

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# SQLite file for the catalogue and the assistant's conversations. Must be a
# writable path; in a read-only deploy the assistant reports itself unavailable
# rather than failing silently.
DB_FILE=data/app.db

# -----------------------------------------------------------------------------
# Existing app configuration
# -----------------------------------------------------------------------------
# The Digital Twin's own Nugen integration reads the same NUGEN_API_KEY but has a
# separate provider, a separate alignment record and a separate manifest
# (src/llm/nugen.ts, scripts/nugen-align.ts). The two do not share a module.
#
# NUGEN_MODEL_ID=            # pinned model for the twin, overriding its record
# NUGEN_OFF=1                # kill switch for the twin too

# The OpenRouter-backed LLM used by the existing NLU/narrator/enricher layer.
# Unrelated to Nugen; absent means the deterministic parsers are the only path.
# OPENROUTER_API_KEY=
# ANANTA_NLU_MODEL=google/gemini-2.5-flash-lite
# ANANTA_LLM_OFF=1
