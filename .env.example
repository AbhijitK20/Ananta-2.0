# Every environment variable this app reads.
#
# There was no example file, so the fourteen names below were only discoverable
# by reading the header comment in src/llm/config.ts. All of them are optional:
# with none of them set the product runs end to end on deterministic parsers and
# says so in the UI rather than pretending a model answered.
#
# Copy to `.env.local` for development. On Vercel, set them in Project Settings.

# --- the only hard requirement for reaching a model ---------------------------

# Without this, parseIntent falls back to a regex reader. The product still works.
OPENROUTER_API_KEY=

# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# --- turning the model off ----------------------------------------------------

# Affirmative, because these are flags NAMED "off": 1|true|on|yes|enabled
#   => off. `LLM=off` and `LLM_OFF=1` mean the same thing to whoever typed them.
# The generic `LLM` is the inverse: only 0|false|off|no|disabled|none => off,
# so `LLM=on` reads as ON. Whichever flag is SET wins.
#LLM_OFF=1
#ANANTA_LLM_OFF=1
#LLM=off

# --- models, per role ---------------------------------------------------------
# The last entry of every chain is never a guess: it is the fallback that runs
# when the primary is rate-limited or down.

#ANANTA_NLU_MODEL=google/gemini-2.5-flash-lite
#ANANTA_NLU_FALLBACK=deepseek/deepseek-v4-flash
#ANANTA_NARRATOR_MODEL=google/gemini-2.5-flash-lite
#ANANTA_ENRICHER_MODEL=google/gemini-2.5-flash-lite

# --- timing and retries -------------------------------------------------------
# All clamped server-side to the range in brackets.

#ANANTA_LLM_TIMEOUT_MS=8000          # 500 - 120000
#ANANTA_LLM_STEP_MS=4000             # 250 - 120000
#ANANTA_LLM_RETRIES=2                # 0 - 5
#ANANTA_BREAKER_FAILURES=4           # 1 - 100
#ANANTA_BREAKER_COOLDOWN_MS=30000    # 1000 - 600000

# --- diagnostics --------------------------------------------------------------

# off | error | warn | info | debug. Defaults to warn in dev, info in production.
#ANANTA_LOG=info

# --- elsewhere in the app -----------------------------------------------------

# Sent to OpenRouter as HTTP-Referer. Defaults to http://localhost:3000
#PUBLIC_SITE_URL=https://travel-buddy-brown.vercel.app

# SQLite file for scripts/seed.ts. Defaults to data/app.db
#DB_FILE=data/app.db

# Refuses to make network routing calls. The engine's haversine estimate is used
# instead, which is what the eval harness runs with so it never touches network.
#TRAVELBUDDY_OFFLINE=1
