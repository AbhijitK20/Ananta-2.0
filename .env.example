# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# ---------------------------------------------------------------------------
#
# Nugen Intelligence — the assistant's model provider.
#
# The assistant is required to run a model aligned to this app's own domain, and
# a base model is never an acceptable substitute: it would answer these questions
# just as well, which would make the alignment impossible to demonstrate. See
# lib/nugen/config.ts for the resolution order and why it has no fallback.

# SERVER-SIDE ONLY. Read in exactly one module, lib/nugen/client.ts, plus
# tools/nugen-align.mjs. Never give this a NEXT_PUBLIC_ prefix: that inlines the
# value into the client bundle and publishes it to every visitor.
#
# Get one at https://nugen.in
NUGEN_API_KEY=

# The aligned model's id.
#
# You normally do NOT set this. The app reads
# data/reference/nugen/alignment.json, which `npm run nugen:align` writes when a
# training run completes, and re-reads it per request so a long-lived dev server
# cannot cache a decision made before the alignment finished.
#
# Set it only to pin a particular model on a demo machine. NEVER put a base model
# id here — `/api/health` cross-checks the model against `/models/base` and
# reports `modelIsBaseModel`, and a base model there makes the alignment claim
# void.
# NUGEN_CUSTOMIZED_MODEL_ID=

# API base. Override for a self-hosted or regional Nugen deployment.
# NUGEN_BASE_URL=https://api.nugen.in/api/v3

# Total budget for one provider call, in ms. Clamped to 500–120000.
# NUGEN_TIMEOUT_MS=20000

# The base model an alignment runs against. Only two are `alignment_ready`:
# llama-v3p2-3b-reasoning and qwen2-vl-2b-instruct.
# NUGEN_BASE_MODEL=llama-v3p2-3b-reasoning

# Name recorded on the alignment project, for provenance in Nugen's dashboard.
# NUGEN_ALIGNMENT_NAME=Local Legends — domain alignment

# Kill switch. Set to 1 to force the offline path with a key still configured —
# this is how the assistant is shown working without their platform.
# NUGEN_OFF=1

# ---------------------------------------------------------------------------
# The rest of the app
# ---------------------------------------------------------------------------

# Set to "system" to reproduce the live site's own font rendering instead of
# self-hosting Fraunces and Inter. See the FONT MODE note in app/globals.css.
# LAL_FONTS=system
