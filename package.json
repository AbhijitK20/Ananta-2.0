{
  "name": "travelbuddy",
  "version": "0.1.0",
  "private": true,
  "description": "Context-aware local experience discovery for time-constrained travellers",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "content:index": "tsx content/tools/validate-content.ts --index",
    "content:validate": "tsx content/tools/validate-content.ts",
    "contrast:lint": "tsx scripts/contrast-lint.ts",
    "copy:lint": "tsx scripts/copy-lint.ts",
    "db:embed": "tsx scripts/embed.ts",
    "db:harvest": "tsx scripts/harvest-osm.ts",
    "db:project": "tsx scripts/osm-project.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "next dev",
    "eval": "tsx scripts/eval.ts",
    "lint": "eslint .",
    "nugen:align": "tsx scripts/nugen-align.ts",
    "nugen:probe": "tsx scripts/nugen-probe.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "theme:lint": "tsx scripts/theme-lint.ts",
    "theme:lint:watch": "tsx scripts/theme-lint.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.8",
    "drizzle-orm": "^0.45.3",
    "better-auth": "^1.7.6",
    "ai": "^7.0.116",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@turf/turf": "^7.4.0",
    "opening_hours": "^3.15.0",
    "maplibre-gl": "^5.0.0",
    "react-map-gl": "^8.0.0",
    "lucide-react": "^0.469.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "tsx": "^4.23.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.26"
  }
}
