{
  "name": "lal-clone",
  "version": "0.0.0",
  "private": true,
  "description": "City travel guides. Multi-city editorial, no accounts, no tracking. Globe imagery gated behind explicit consent.",
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "next build",
    "start": "next start --port 4310",
    "typecheck": "tsc --noEmit",
    "capture": "node tools/capture.mjs",
    "check:plan": "tsx tools/check-plan.mjs",
    "check:sync": "tsx tools/check-sync.mjs",
    "check:twin": "node tools/check-twin.mjs",
    "auth:migrate": "tsx --env-file-if-exists=.env.local tools/migrate.mjs",
    "smoke:plan": "node tools/smoke-plan.mjs",
    "verify": "node tools/verify.mjs",
    "verify:places": "node tools/verify-places.mjs",
    "predev": "node tools/copy-cesium-assets.mjs",
    "prebuild": "node tools/copy-cesium-assets.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "cesium": "^1.145.0",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.26",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
