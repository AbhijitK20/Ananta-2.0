{
  "name": "lal-clone",
  "version": "0.0.0",
  "private": true,
  "description": "Pixel-faithful frontend clone of likealocalguide.com, captured not eyeballed. Reference material: not product surface.",
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "next build",
    "start": "next start --port 4310",
    "typecheck": "tsc --noEmit",
    "corpus:build": "esbuild tools/build-nugen-corpus.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/nugen-corpus.mjs --log-level=warning && node node_modules/.cache/nugen-corpus.mjs",
    "nugen:align": "node tools/nugen-align.mjs",
    "capture": "node tools/capture.mjs",
    "verify": "node tools/verify.mjs",
    "verify:places": "node tools/verify-places.mjs",
    "predev": "node tools/copy-cesium-assets.mjs",
    "prebuild": "node tools/copy-cesium-assets.mjs"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "gsap": "^3.15.0",
    "next": "15.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.49.1",
    "typescript": "~5.9.3"
  }
}
