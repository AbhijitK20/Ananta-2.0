{"id":"adj-museum-of-mumbai","name":"Museum of Mumbai, indoor galleries","category":"museum","location":{"lat":18.9313,"lon":72.8341},"durationMin":70,"pricePerPerson":{"minor":10000,"currency":"INR"},"capacity":80,"hours":{"raw":"Mo-Su 10:00-18:00; We off","status":"ok","lastVerified":null},"indoorOutdoor":"indoor","accessibility":{"stepFree":true,"strollerOk":true,"lowStairs":true,"seatingAvailable":true,"hearingLoop":true,"restroomOnSite":true},"kidFriendly":true,"minAge":7,"diets":[],"cuisines":[],"rating":{"value":4.16,"count":2,"rawMean":4.5},"blurb":"Scale models of the city as it grew, a room of recycled street signs, and lift access throughout. The reliable wet-weather answer in the Fort.","description":"A local history museum with an unusually good collection of large scale models of the city, plus a room of salvaged street furniture and a photograph gallery. Lift to every floor, toilets on site, a hearing loop at the desk, and it is the Fort record most likely to satisfy an elderly visitor and a wheelchair user in the same plan. Closed Wednesdays.","keywords":["museum of mumbai","scale models","street signs","photograph gallery","lift access","closed wednesday","wet weather fort","elderly friendly"],"perception":{"landscape":["galleries of scale models","photograph walls","recycled street signs","wide corridors"],"activities":["looking at city models","reading photographs","a dry indoor hour"],"atmosphere":["cool","quiet","institutional","curated"]},"bestTimeOfDay":["morning","afternoon"],"requiresJourney":false,"booking":{"required":false,"leadTimeMin":0,"walkIn":true},"bestMonths":[11,12,1,2,3,6,7,8,9],"weatherSensitive":"none","provenance":{"location":"inferred","name":"inferred","durationMin":"inferred","pricePerPerson":"inferred","hours":"inferred","accessibility.stepFree":"inferred","accessibility.restroomOnSite":"inferred","accessibility.hearingLoop":"inferred","rating":"inferred"},"providerId":null,"neighbourhood":"Fort","__meta":{"synthetic":true