{
  "name": "lal-quest",
  "version": "0.1.0",
  "private": true,
  "description": "Local Legends — a gamified local-discovery app built on the Like a Local Guide place dataset",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 4311",
    "build": "next build",
    "start": "next start --port 4311",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check.ts",
    "verify": "bash scripts/verify.sh",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
